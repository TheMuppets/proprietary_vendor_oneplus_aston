service oplus.hal.cammidasservice-1-0 /odm/bin/hw/vendor.oplus.hardware.cammidasservice-V1-service
    class hal
    user system
    group system
    interface aidl vendor.oplus.hardware.cammidasservice.IMIDASService/default

on property:persist.sys.midasd.start=1
    start oplus.hal.cammidasservice-1-0

on property:persist.sys.midasd.start=0
    stop oplus.hal.cammidasservice-1-0
